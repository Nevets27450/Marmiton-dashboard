	column Intervalle =
			
			VAR d = recipes[total_time_min]
			RETURN
			CALCULATE(
			    MAX(Table_Intervalle[Intervalle]),
			    FILTER(
			        Table_Intervalle,
			        d >= Table_Intervalle[Min_Borne]
			        && d <= Table_Intervalle[Max_Borne]
			))
		lineageTag: 613979a0-f21b-4223-800f-770bdcfc46c4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition recipes = m
		mode: import
